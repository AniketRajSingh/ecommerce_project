CREATE TABLE IF NOT EXISTS "home_review" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "customer_name" varchar(100) NOT NULL, "location" varchar(100) NOT NULL, "review_text" text NOT NULL, "photo_url" varchar(100) NULL);
INSERT INTO "home_review" VALUES(1,'Harshal Shewale','Pune','Best one amongst I have ever purchased. I had also purchased Seasome oil of this brand. It was of very good quality. On this experience I purchased cold pressed groundnut oil and found of best quality as expected.','');
INSERT INTO "home_review" VALUES(2,'Vineet Bharadwaj','Panipat','I switched to cold pressed oil around five years back when the concept was fairly getting noticed. Took some while to figure out authentic taste even though we know immense benefits it has. Very happy to have chanced upon this brand on Amazon.','');
INSERT INTO "home_review" VALUES(4,'Meenal Ohol','Pune','I am  very much satisfied with the products sold by Snehsattva. I am rest assured that all are pure and natural. This relives me from tension that whether I am giving best nutritious and pure food to my family.','');
