CREATE TABLE IF NOT EXISTS "store_product" ("id" integer NOT NULL PRIMARY KEY AUTOINCREMENT, "name" varchar(200) NOT NULL, "description" text NULL, "short_description" text NULL, "bestsellers_img" varchar(100) NULL);
INSERT INTO "store_product" VALUES(1,'Cold Pressed Coconut Oil','Cold-pressed coconut oil is a natural oil that is extracted from the meat of mature coconuts without the use of heat or chemicals. This method of extraction preserves the oil''s natural nutrients, making it a healthier and more beneficial option than other processed coconut oils.

 Here are some of the benefits of using cold-pressed coconut oil:

1.Promotes Heart Health: Cold-pressed coconut oil contains medium-chain triglycerides (MCTs), which are easily digested and metabolized by the body. Studies have shown that MCTs can help reduce cholesterol levels and improve overall heart health.

2.Boosts Immune System: Cold-pressed coconut oil is rich in lauric acid, which is known to have antimicrobial properties. Lauric acid can help boost the immune system by fighting off harmful bacteria, viruses, and fungi.

3.Aids in Digestion: The MCTs in cold-pressed coconut oil can help improve digestion and nutrient absorption in the body. This can be particularly beneficial for those with digestive issues or malabsorption problems.

4.Moisturizes Skin and Hair: Cold-pressed coconut oil is a natural moisturizer that can help nourish and hydrate the skin and hair. Its high fatty acid content helps keep the skin and hair soft and supple.

5.Improves Brain Function: The MCTs in cold-pressed coconut oil can also help improve brain function and memory. Studies have shown that MCTs can help increase ketone levels in the brain, which may improve cognitive function in people with Alzheimer''s and other neurological disorders.

6.Supports Weight Loss: The MCTs in cold-pressed coconut oil can help boost metabolism and promote fat burning, making it a useful tool for weight loss. It can also help reduce appetite and cravings, which can make it easier to stick to a healthy diet.

In summary, cold-pressed coconut oil is a natural, versatile oil that offers a wide range of health benefits. Its high nutrient content and unique fatty acid profile make it a valuable addition to any healthy lifestyle.','Revitalize with our cold-pressed coconut oil—promotes heart health, boosts immunity, aids digestion, nourishes skin and hair, enhances brain function, and supports weight loss. Pure well-being in a bottle!','bestsellers/1000075348.jpg');
INSERT INTO "store_product" VALUES(2,'Cold Pressed Mustard OIl','Kachi Ghani Mustard Oil (sarso oil) is extracted from mustard seeds (black, brown and white), and is reddish brown or amber in colour. It has been commonly used in North and East India since ancient times, and comes with a bevy of health benefits.

1.Good for Heart Health: Cold pressed mustard oil is rich in monounsaturated and polyunsaturated fats, which are considered healthy fats that can help reduce the risk of heart disease. These fats help to reduce bad cholesterol (LDL) levels and increase good cholesterol (HDL) levels in the body.

2.Boosts Immunity: Mustard oil is a good source of antioxidants, which helps to boost the immune system and protect the body from harmful free radicals.

3.Promotes Healthy Skin: Mustard oil is rich in Vitamin E, which helps to nourish and hydrate the skin. It also has anti-inflammatory and anti-bacterial properties that help to reduce skin infections and prevent acne.

4.Relieves Joint Pain: Cold pressed mustard oil has anti-inflammatory properties that help to reduce joint pain and swelling. It is commonly used in Ayurvedic medicine to treat joint pain and arthritis.
Promotes Hair Growth: Mustard oil is rich in essential fatty acids, which helps to nourish and strengthen the hair. It also has anti-fungal properties that help to prevent dandruff and other scalp infections.

5.Improves Digestion: Mustard oil stimulates the production of digestive juices, which helps to improve digestion and prevent digestive problems such as constipation, bloating and gas.

6.Acts as a Natural Insect Repellent: Mustard oil has a strong pungent Odor that acts as a natural insect repellent. It is commonly used to repel mosquitoes and other insects.
It''s important to note that while cold pressed mustard oil has several potential health benefits, it is still recommended to consume it in moderation.','Kachi Ghani Mustard Oil, extracted from mustard seeds, offers heart health, immunity boost, skin and joint benefits, promoting digestion and acting as a natural insect repellent','bestsellers/1000075642.jpg');
INSERT INTO "store_product" VALUES(3,'Cold Pressed Sunflower  Oil','Cold-pressed sunflower oil is a natural oil that is extracted from sunflower seeds without the use of heat or chemicals. This method of extraction preserves the oil''s natural nutrients, making it a healthier and more beneficial option than other processed sunflower oils. Here are some of the benefits of using cold-pressed sunflower oil:

1.Promotes Heart Health: Cold-pressed sunflower oil is rich in healthy unsaturated fats, such as omega-3 and omega-6 fatty acids, which can help reduce inflammation and lower cholesterol levels. This can help improve heart health and reduce the risk of heart disease.

2.Boosts Immune System: Cold-pressed sunflower oil is a rich source of vitamin E, which is a powerful antioxidant that can help boost the immune system and protect the body from free radical damage. Vitamin E can also help improve skin health and reduce the risk of certain cancers.

3.Improves Skin Health: Cold-pressed sunflower oil is a natural moisturizer that can help nourish and hydrate the skin. Its high vitamin E content can also help reduce the appearance of fine lines and wrinkles and protect the skin from sun damage.

4.Aids in Digestion: Cold-pressed sunflower oil is a good source of fiber, which can help improve digestion and promote regular bowel movements. It can also help reduce inflammation in the gut and improve nutrient absorption.

5.Supports Weight Loss: Cold-pressed sunflower oil is a low-calorie and low-fat option that can help support weight loss. It can help boost metabolism and promote fat burning, making it a useful tool for weight management.

6.Boosts Energy: Cold-pressed sunflower oil is a good source of essential fatty acids, which can help improve energy levels and reduce fatigue. It can also help improve mood and cognitive function.','Cold-pressed sunflower oil, extracted without heat or chemicals, promotes heart health, boosts immunity, enhances skin, aids digestion, supports weight loss, and boosts energy.','bestsellers/1000075346_OeIS3L8.jpg');
INSERT INTO "store_product" VALUES(4,'Cold Pressed Groundnut Oil','Cold pressed groundnut oil is a type of oil that is extracted from groundnuts (also known as peanuts) through a mechanical process that does not involve the use of heat or chemicals. This process helps to retain the natural nutrients and flavor of the oil.

1.Groundnut oil is a good source of healthy fats, including monounsaturated and polyunsaturated fats, which are considered beneficial for heart health. It is also rich in antioxidants, such as Vitamin E, which helps to protect the body from harmful free radicals.

2.Cold pressed groundnut oil is commonly used for cooking due to its high smoke point, which means that it can withstand high temperatures without burning or smoking. This makes it ideal for deep frying, sautéing and other high heat cooking methods.

3.Snehsattva Cold Pressed Groundnut Oil is 100% natural & pure. It is specifically prepared from fresh groundnuts through a meticulous and engineered process.

Extracted through no heat process to preserve natural goodness rich Aroma. 100% pure, unadulterated oil, ensured by the Fatty Acid Profiling process.

Free from trans-fat. No Preservatives added.

It’s a good source of the antioxidant vitamin E, which may help reduce heart disease risk factors. It may also help improve insulin sensitivity and blood sugar in those with diabetes.

Completely free of cholesterol

Store in cool and dry place at room temperature.
Avoid Sunlight exposure"','Snehsattva Cold Pressed Groundnut Oil','bestsellers/1000075347_YbHIm1q.jpg');
INSERT INTO "store_product" VALUES(5,'Cold Pressed Til Oil','Cold-pressed til oil, also known as sesame oil, is a natural oil that is extracted from sesame seeds without the use of heat or chemicals. This method of extraction preserves the oil''s natural nutrients, making it a healthier and more beneficial option than other processed sesame oils. Here are some of the benefits of using cold-pressed til oil:

1.Promotes Heart Health: Cold-pressed til oil is rich in healthy unsaturated fats, including omega-3, omega-6, and omega-9 fatty acids, which can help lower cholesterol levels and reduce the risk of heart disease.

2.Improves Skin Health: Cold-pressed til oil is a natural moisturizer that can help hydrate and nourish the skin. Its high vitamin E content can also help reduce inflammation and improve skin texture.

3.Reduces Inflammation: Cold-pressed til oil contains a high amount of sesamol, which is a natural anti-inflammatory compound. Consuming til oil can help reduce inflammation in the body, which can be beneficial for those with inflammatory conditions, such as arthritis or asthma.

4.Aids in Digestion: Cold-pressed til oil is a good source of fiber, which can help improve digestion and promote regular bowel movements. It can also help reduce inflammation in the gut and improve nutrient absorption.

5.Supports Bone Health: Cold-pressed til oil is a good source of calcium, which is essential for strong and healthy bones. Consuming til oil can help reduce the risk of osteoporosis and other bone-related conditions.

6.Boosts Immune System: Cold-pressed til oil is a good source of antioxidants, including sesamol and sesamin, which can help boost the immune system and protect the body from free radical damage. It can also help reduce the risk of certain cancers.

In summary, cold-pressed til oil is a natural and nutritious oil that offers a range of health benefits. Its high nutrient content and unique fatty acid profile make it a valuable addition to any healthy lifestyle.','Cold-pressed til oil, extracted from sesame seeds, promotes heart health, skin nourishment, inflammation reduction, digestion, bone health, and immune system support. A natural and nutritious choice','bestsellers/1000075342.jpg');
INSERT INTO "store_product" VALUES(6,'Cold Pressed Safflower Oil','Cold-pressed safflower oil is a natural oil that is extracted from safflower seeds without the use of heat or chemicals. This method of extraction preserves the oil''s natural nutrients, making it a healthier and more beneficial option than other processed safflower oils. Here are some of the benefits of using cold-pressed safflower oil:

1.Promotes Heart Health: Cold-pressed safflower oil is rich in healthy unsaturated fats, including omega-6 and omega-9 fatty acids, which can help lower cholesterol levels and reduce the risk of heart disease.

2.Aids in Weight Loss: Cold-pressed safflower oil contains a high amount of linoleic acid, which can help boost metabolism and promote fat burning. Studies have shown that consuming safflower oil can help reduce belly fat and improve body composition.
Improves Skin Health: Cold-pressed safflower oil is a natural moisturizer that can help hydrate and nourish the skin. Its high linoleic acid content can also help reduce inflammation and improve skin texture.

3.Reduces Inflammation: Cold-pressed safflower oil contains a high amount of omega-6 fatty acids, which can help reduce inflammation in the body. This can be particularly beneficial for those with inflammatory conditions, such as arthritis or asthma.

4.Supports Immune System: Cold-pressed safflower oil is a good source of vitamin E, which is a powerful antioxidant that can help boost the immune system and protect the body from free radical damage. Vitamin E can also help improve skin health and reduce the risk of certain cancers.

5.Improves Digestion: Cold-pressed safflower oil is a good source of fibre, which can help improve digestion and promote regular bowel movements. It can also help reduce inflammation in the gut and improve nutrient absorption.

In summary, cold-pressed safflower oil is a natural and nutritious oil that offers a range of health benefits. Its high nutrient content and unique fatty acid profile make it a valuable addition to any healthy lifestyle.','Cold-pressed safflower oil, rich in omega-6 fatty acids and vitamin E, promotes heart health, aids weight loss, improves skin, reduces inflammation, and supports digestion.','bestsellers/1000075344.jpg');
INSERT INTO "store_product" VALUES(8,'Badam Oil','Badam Oil','Badam Oil','bestsellers/1000075347.jpg');
